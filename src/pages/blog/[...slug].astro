---
import { render } from 'astro:content';
import BlogPage from '../../layouts/BlogPage.astro';
import { formatPostDate, getPosts, postDateIso } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BlogPage title={`${post.data.title} | Blog`} description={post.data.description}>
  <article class="blog-post section">
    <a class="blog-back" href="/blog" aria-label="All posts">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M19 12H5"></path>
        <path d="m12 19-7-7 7-7"></path>
      </svg>
    </a>
    <h1>{post.data.title}</h1>
    <time datetime={postDateIso(post.data.date)}>{formatPostDate(post.data.date)}</time>
    {post.data.cover && <img class="blog-hero" src={post.data.cover} alt="" />}
    <div class="blog-body">
      <Content />
    </div>
  </article>
</BlogPage>
