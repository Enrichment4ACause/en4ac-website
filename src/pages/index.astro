---
import Site from '../components/Site.tsx';
import Analytics from '@vercel/analytics/astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#003f78" />
    <meta
      name="description"
      content="Enrichment For A Cause connects student teams with nonprofit projects. Build something useful, learn with your team, and support your community."
    />
    <link rel="icon" type="image/svg+xml" href="/images/en4ac-logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=DM+Sans:wght@400;450;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>Enrichment For A Cause | Put your skills to good use</title>
  </head>
  <body>
    <Site client:load />
    <Analytics />
  </body>
</html>
